datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BrandProfile {
  id                   String   @id @default(cuid())
  title                String
  bioEn                String
  bioEs                String
  logoUrl              String
  whatsappNumber       String
  whatsappDefaultMsgEn String
  whatsappDefaultMsgEs String
  bannerTextEn         String
  bannerTextEs         String
  promoCode            String
  showBanner           Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  titleEn     String
  titleEs     String
  price       Float
  imageUrl    String
  buyUrl      String
  badgeTextEn String?
  badgeTextEs String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Link {
  id        String   @id @default(cuid())
  titleEn   String
  titleEs   String
  url       String
  icon      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
